<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.MainView">
  <!--
    Mobile root: the five screens over a hand-built bottom nav bar.

    The TabControl is kept purely as the content switcher — SelectedIndex still drives everything,
    so the per-tab refreshes below are unchanged — but its own header strip is hidden (the
    `headless` class) and the bar underneath is drawn here instead. Five stock TabItems shrank to
    12pt text with no icons and no active state worth the name; this gives each destination an
    icon, a label and a gold pill when it's the one you're on.

    Styles come from MobileTheme, included here rather than in App.axaml because App is shared with
    the Mac head — everything in that file cascades to these five screens and to nothing else.
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://1001AlbumHelper.Core/Views/Mobile/MobileTheme.axaml" />
  </UserControl.Styles>

  <Border Classes="page">
    <Grid RowDefinitions="*,Auto">

      <TabControl Grid.Row="0" x:Name="Tabs" Classes="headless">
        <TabItem>
          <local:AlbumListView />
        </TabItem>
        <TabItem>
          <local:RateView />
        </TabItem>
        <TabItem>
          <local:ReplacementsView x:Name="ShortlistView" />
        </TabItem>
        <TabItem>
          <local:PlaylistView x:Name="Playlist1View" />
        </TabItem>
        <TabItem>
          <local:PlaylistView x:Name="Playlist2View" />
        </TabItem>
      </TabControl>

      <!-- Tag is the tab index the button selects; the code-behind keeps `on` in step with it. -->
      <Border Grid.Row="1" Classes="navBar">
        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2">
          <Button Grid.Column="0" x:Name="NavList" Classes="nav on" Tag="0" Click="OnNavigate">
            <StackPanel Spacing="3">
              <TextBlock Text="☰" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="List" FontSize="9.5" FontWeight="Medium" Opacity="0.85"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" x:Name="NavRate" Classes="nav" Tag="1" Click="OnNavigate">
            <StackPanel Spacing="3">
              <TextBlock Text="★" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="Rate" FontSize="9.5" FontWeight="Medium" Opacity="0.85"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" x:Name="NavShortlist" Classes="nav" Tag="2" Click="OnNavigate">
            <StackPanel Spacing="3">
              <TextBlock Text="♡" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="Shortlist" FontSize="9.5" FontWeight="Medium" Opacity="0.85"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" x:Name="NavPlaylist1" Classes="nav" Tag="3" Click="OnNavigate">
            <StackPanel Spacing="3">
              <TextBlock Text="♫" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="P1" FontSize="9.5" FontWeight="Medium" Opacity="0.85"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" x:Name="NavPlaylist2" Classes="nav" Tag="4" Click="OnNavigate">
            <StackPanel Spacing="3">
              <TextBlock Text="♫" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="P2" FontSize="9.5" FontWeight="Medium" Opacity="0.85"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

    </Grid>
  </Border>
</UserControl>
