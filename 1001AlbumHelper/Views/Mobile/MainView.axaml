<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.MainView">
  <!--
    Mobile root: a top dropdown picker swaps between the five screens (replaced the
    bottom tab bar — five destinations was cramped as tabs and ate vertical space).
    All five views are created once and kept alive so their state (scroll position,
    in-progress edits) survives switching away and back; visibility toggles which
    one is shown.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#33808080">
      <ComboBox x:Name="ScreenPicker" HorizontalAlignment="Stretch" SelectedIndex="0">
        <ComboBoxItem Content="Lists" />
        <ComboBoxItem Content="Rate" />
        <ComboBoxItem Content="Potentials" />
        <ComboBoxItem Content="Playlist 1" />
        <ComboBoxItem Content="Playlist 2" />
      </ComboBox>
    </Border>

    <Panel>
      <local:AlbumListView x:Name="ListsScreen" />
      <local:RateView x:Name="RateScreen" IsVisible="False" />
      <local:ReplacementsView x:Name="PotentialsScreen" IsVisible="False" />
      <local:PlaylistView x:Name="Playlist1View" IsVisible="False" />
      <local:PlaylistView x:Name="Playlist2View" IsVisible="False" />
    </Panel>
  </DockPanel>
</UserControl>
