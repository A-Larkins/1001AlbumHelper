<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.RateView">
  <UserControl.Styles>
    <!-- Same segmented look the Browse tab uses for its list picker. -->
    <Style Selector="Button.seg">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Rate" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" x:Name="RemainingText" Text="" Opacity="0.55" FontSize="12"
                 VerticalAlignment="Center" />
    </Grid>

    <!-- Which albums this run walks. The three queues the Mac window offers, minus shuffle. -->
    <Grid Grid.Row="1" x:Name="ModeRow" ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,0,0,6">
      <Button Grid.Column="0" x:Name="NextUpButton" Classes="seg on" Tag="NextUp" Content="Next up"
              Click="OnPickMode" />
      <Button Grid.Column="1" x:Name="BackfillButton" Classes="seg" Tag="Backfill" Content="Backfill ✓"
              Click="OnPickMode" />
      <Button Grid.Column="2" x:Name="RevisitButton" Classes="seg" Tag="Revisit" Content="Revisit"
              Click="OnPickMode" />
    </Grid>

    <!-- Which ratings Revisit walks. Hidden for the other two, whose albums have none to filter by. -->
    <Grid Grid.Row="2" x:Name="FilterRow" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4"
          Margin="0,0,0,6" IsVisible="False">
      <Button Grid.Column="0" Classes="seg on" Tag="" Content="All" Click="OnPickFilter" />
      <Button Grid.Column="1" Classes="seg" Tag="⭐" Content="⭐" Click="OnPickFilter" />
      <Button Grid.Column="2" Classes="seg" Tag="👍" Content="👍" Click="OnPickFilter" />
      <Button Grid.Column="3" Classes="seg" Tag="👎" Content="👎" Click="OnPickFilter" />
      <Button Grid.Column="4" Classes="seg" Tag="❌" Content="❌" Click="OnPickFilter" />
    </Grid>

    <Border Grid.Row="3" CornerRadius="14" BorderBrush="#33808080" BorderThickness="1" Padding="24"
            MinHeight="220">
      <Panel>
        <StackPanel x:Name="AlbumPanel" VerticalAlignment="Center" Spacing="0">
          <TextBlock x:Name="PositionText" Text="" FontSize="12" Opacity="0.5"
                     HorizontalAlignment="Center" />

          <!-- Cover art. The sleeve placeholder holds the space while the lookup runs (and for
               albums with no art), so the card doesn't jump between two heights. -->
          <Border Width="150" Height="150" CornerRadius="10" ClipToBounds="True"
                  BorderBrush="#33808080" BorderThickness="1"
                  HorizontalAlignment="Center" Margin="0,12,0,0">
            <Panel>
              <TextBlock x:Name="ArtPlaceholder" Text="♫" FontSize="40" Opacity="0.25"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="ArtImage" Stretch="UniformToFill" IsVisible="False" />
            </Panel>
          </Border>
          <TextBlock x:Name="TitleText" Text="" FontSize="24" FontWeight="Bold"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
          <TextBlock x:Name="ArtistText" Text="" FontSize="16" Opacity="0.75"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
          <TextBlock x:Name="YearText" Text="" FontSize="13" Opacity="0.5"
                     HorizontalAlignment="Center" Margin="0,6,0,0" />
          <!-- Only shown for an album that already has a rating — otherwise there's nothing to say. -->
          <TextBlock x:Name="CurrentRatingText" Text="" FontSize="12.5" Opacity="0.85"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Text="Loading…" FontSize="15" Opacity="0.7"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
      </Panel>
    </Border>

    <Grid Grid.Row="4" x:Name="RatingRow" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
      <Button Grid.Column="0" Tag="⭐" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Really enjoyable" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Tag="👍" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="👍" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Mostly enjoyable" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Tag="👎" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="👎" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Mostly sucks" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Tag="❌" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="❌" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Trash" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,10,0,0">
      <TextBlock Grid.Column="0" x:Name="StatusText" Text="" FontSize="12" Opacity="0.6"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="BackButton" Content="Back" Click="OnBack" FontSize="12" />
      <Button Grid.Column="2" x:Name="SkipButton" Content="Skip" Click="OnSkip" FontSize="12" />
    </Grid>

    <!-- Jump to any album by name, rated or not — the phone's way of changing a rating, since it
         has no queue picker. Results only appear once something is typed. -->
    <DockPanel Grid.Row="6" Margin="0,12,0,0">
      <TextBox DockPanel.Dock="Top" x:Name="FindBox"
               Watermark="Find an album to rate or re-rate…" FontSize="13" />
      <ListBox x:Name="FindResults" SelectionChanged="OnPickFound" Margin="0,6,0,0"
               Background="Transparent" BorderThickness="0" IsVisible="False">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:AlbumEntry">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{Binding Rating}" FontSize="13" Margin="0,0,8,0"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Artist}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Year}" Opacity="0.45" FontSize="12"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
