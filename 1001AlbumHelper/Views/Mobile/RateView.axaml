<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.RateView">
  <!--
    Rate. The album card is the screen: sleeve, title, artist, year, centered and given room, with
    the four verdicts as colored tiles directly under your thumb.

    Everything you steer with lives in the pinned header: the queue picker, and under it a search
    field that is always on screen. The field used to sit in the last row of the layout, which on a
    phone is exactly where iOS puts the keyboard — tapping it hid the field, the matches it was
    producing and the rating tiles all at once, so you typed a name blind. Up here the keyboard
    opens *below* it, and the results take the card's place instead of being buried under glass.

    The "A–Z" button opens those same results without raising the keyboard, for when skimming the
    index rail beats typing a name.
  -->
  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="header">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="title" Text="Rate" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="RemainingText" Classes="caption" Text=""
                     VerticalAlignment="Bottom" Margin="8,0,0,4" />
        </Grid>

        <!-- Which albums this run walks. The three queues the Mac window offers, minus shuffle. -->
        <Border Classes="segTrack">
          <Grid x:Name="ModeRow" ColumnDefinitions="*,*,*" ColumnSpacing="3">
            <Button Grid.Column="0" x:Name="NextUpButton" Classes="seg on" Tag="NextUp"
                    Content="Next up" Click="OnPickMode" />
            <Button Grid.Column="1" x:Name="BackfillButton" Classes="seg" Tag="Backfill"
                    Content="Backfill ✓" Click="OnPickMode" />
            <Button Grid.Column="2" x:Name="RevisitButton" Classes="seg" Tag="Revisit"
                    Content="Revisit" Click="OnPickMode" />
          </Grid>
        </Border>

        <!-- Which ratings Revisit walks. Hidden for the other two, whose albums have none to
             filter by — the visibility is set on the track so the whole control disappears. -->
        <Border x:Name="FilterTrack" Classes="segTrack" IsVisible="False">
          <Grid x:Name="FilterRow" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="3">
            <Button Grid.Column="0" Classes="seg on" Tag="" Content="All" Click="OnPickFilter" />
            <Button Grid.Column="1" Classes="seg" Tag="⭐" Content="⭐" Click="OnPickFilter" />
            <Button Grid.Column="2" Classes="seg" Tag="👍" Content="👍" Click="OnPickFilter" />
            <Button Grid.Column="3" Classes="seg" Tag="👎" Content="👎" Click="OnPickFilter" />
            <Button Grid.Column="4" Classes="seg" Tag="❌" Content="❌" Click="OnPickFilter" />
          </Grid>
        </Border>

        <!-- Always here, whichever queue you're in: type a name, or take the A–Z index instead.
             Cancel only appears once the results are up, since that's the only time it does
             anything. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" x:Name="FindBox" Watermark="Search or jump to an album…"
                   GotFocus="OnFindFocus" />
          <Button Grid.Column="1" x:Name="BrowseButton" Classes="chip gold" Content="A–Z"
                  Click="OnBrowse" VerticalAlignment="Center" />
          <Button Grid.Column="2" x:Name="CancelFindButton" Classes="chip quiet" Content="Cancel"
                  Click="OnCloseFind" VerticalAlignment="Center" IsVisible="False" />
        </Grid>

      </StackPanel>
    </Border>

    <!-- The card takes the slack below the header; the results panel takes the same space when
         it's up, so the two never fight over the screen. -->
    <Panel>

      <Grid Margin="16,14,16,14" RowDefinitions="*,Auto,Auto">

        <Border Grid.Row="0" Classes="card" Padding="20,22" MinHeight="240">
          <Panel>
            <StackPanel x:Name="AlbumPanel" VerticalAlignment="Center" Spacing="0">
              <TextBlock x:Name="PositionText" Classes="rubric" Text="" HorizontalAlignment="Center" />

              <!-- Cover art. The sleeve placeholder holds the space while the lookup runs (and for
                   albums with no art), so the card doesn't jump between two heights. -->
              <Border Width="168" Height="168" CornerRadius="12" ClipToBounds="True"
                      Background="#12141A" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                      BoxShadow="0 12 34 -8 #A0000000"
                      HorizontalAlignment="Center" Margin="0,16,0,0">
                <Panel>
                  <TextBlock x:Name="ArtPlaceholder" Text="♫" FontSize="44"
                             Foreground="{StaticResource TextLow}" Opacity="0.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="ArtImage" Stretch="UniformToFill" IsVisible="False" />
                </Panel>
              </Border>

              <TextBlock x:Name="TitleText" Text="" FontSize="22" FontWeight="Bold" LetterSpacing="-0.4"
                         Foreground="{StaticResource TextHi}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
              <TextBlock x:Name="ArtistText" Text="" FontSize="14.5"
                         Foreground="{StaticResource TextMid}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
              <TextBlock x:Name="YearText" Classes="caption" Text=""
                         HorizontalAlignment="Center" Margin="0,7,0,0" />
              <!-- Only shown for an album that already has a rating — otherwise there's nothing to say. -->
              <TextBlock x:Name="CurrentRatingText" Classes="gold" Text="" FontSize="12"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" IsVisible="False" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="Loading…" FontSize="14"
                       Foreground="{StaticResource TextMid}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
          </Panel>
        </Border>

        <!-- The four verdicts, each in its own color so the row reads ⭐ → ❌ at a glance. -->
        <Grid Grid.Row="1" x:Name="RatingRow" ColumnDefinitions="*,*,*,*" ColumnSpacing="8"
              Margin="0,14,0,0">
          <Button Grid.Column="0" Classes="rate star" Tag="⭐" Click="OnRate">
            <StackPanel>
              <TextBlock Classes="glyph" Text="⭐" />
              <TextBlock Classes="label" Text="Really enjoyable" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="rate up" Tag="👍" Click="OnRate">
            <StackPanel>
              <TextBlock Classes="glyph" Text="👍" />
              <TextBlock Classes="label" Text="Mostly enjoyable" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="rate down" Tag="👎" Click="OnRate">
            <StackPanel>
              <TextBlock Classes="glyph" Text="👎" />
              <TextBlock Classes="label" Text="Mostly sucks" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="rate trash" Tag="❌" Click="OnRate">
            <StackPanel>
              <TextBlock Classes="glyph" Text="❌" />
              <TextBlock Classes="label" Text="Trash" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,12,0,0">
          <TextBlock Grid.Column="0" x:Name="StatusText" Classes="caption" Text=""
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="BackButton" Classes="chip quiet" Content="Back" Click="OnBack" />
          <Button Grid.Column="2" x:Name="SkipButton" Classes="chip quiet" Content="Skip" Click="OnSkip" />
        </Grid>

      </Grid>

      <!--
        The results. Any album on the list, rated or not — an empty field means all 1089, so this
        is browsable before a character is typed. The A–Z rail down the right edge works the way
        the index in Contacts does: press and drag, and the list skims with it.
      -->
      <Border x:Name="FindSheet" Classes="page" IsVisible="False">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="9" Margin="16,12,16,10">
            <!-- What the list is in, which is also what the rail indexes: initial letters for the
                 two name orders, hundreds for the list's own numbering. -->
            <Border Classes="segTrack">
              <Grid x:Name="FindSortRow" ColumnDefinitions="*,*,*" ColumnSpacing="3">
                <Button Grid.Column="0" Classes="seg on" Tag="Title" Content="Title A–Z"
                        Click="OnPickFindSort" />
                <Button Grid.Column="1" Classes="seg" Tag="Artist" Content="Artist A–Z"
                        Click="OnPickFindSort" />
                <Button Grid.Column="2" Classes="seg" Tag="Number" Content="List order"
                        Click="OnPickFindSort" />
              </Grid>
            </Border>
            <TextBlock x:Name="FindCountText" Classes="caption" Text="" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">

            <ListBox Grid.Column="0" x:Name="FindResults" SelectionChanged="OnPickFound">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:AlbumEntry">
                  <Grid ColumnDefinitions="34,22,*,38" Margin="0,10">
                    <TextBlock Grid.Column="0" Classes="rowIndex" Text="{Binding Number}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Rating}" FontSize="13"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="rowTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="rowSub" Text="{Binding Artist}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Classes="rowIndex" Text="{Binding Year}"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="4,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Column="0" x:Name="FindEmptyText" Classes="caption" IsVisible="False"
                       Text="Nothing on the list matches that." TextWrapping="Wrap"
                       TextAlignment="Center" Margin="32,28,32,0" VerticalAlignment="Top" />

            <!-- The rail. Letters are laid in from code, since which ones there are depends on the
                 sort — see BuildRail. The Viewbox shrinks all 27 of them to whatever height is left
                 once the keyboard is up, rather than letting the strip run off the bottom. -->
            <Border Grid.Column="1" x:Name="IndexRail" Classes="rail" ClipToBounds="True"
                    PointerPressed="OnRailPressed" PointerMoved="OnRailMoved"
                    PointerReleased="OnRailReleased" PointerCaptureLost="OnRailCaptureLost">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                <StackPanel x:Name="RailStack" />
              </Viewbox>
            </Border>

            <!-- The big letter under your thumb while you drag, the way the OS shows it. Over the
                 list rather than in the gutter, where your own finger would cover it. -->
            <Border Grid.Column="0" x:Name="RailBubble" Classes="railBubble" IsVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock x:Name="RailBubbleText" Text="" />
            </Border>

          </Grid>

        </DockPanel>
      </Border>

    </Panel>
  </DockPanel>
</UserControl>
