<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.RateView">
  <Grid Margin="12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" MinHeight="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Rate" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" x:Name="RemainingText" Text="" Opacity="0.55" FontSize="12"
                 VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" CornerRadius="14" BorderBrush="#33808080" BorderThickness="1" Padding="24"
            MinHeight="220">
      <Panel>
        <StackPanel x:Name="AlbumPanel" VerticalAlignment="Center" Spacing="0">
          <TextBlock x:Name="PositionText" Text="" FontSize="12" Opacity="0.5"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="TitleText" Text="" FontSize="24" FontWeight="Bold"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
          <TextBlock x:Name="ArtistText" Text="" FontSize="16" Opacity="0.75"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
          <TextBlock x:Name="YearText" Text="" FontSize="13" Opacity="0.5"
                     HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Text="Loading…" FontSize="15" Opacity="0.7"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
      </Panel>
    </Border>

    <Grid Grid.Row="2" x:Name="RatingRow" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,10,0,0">
      <Button Grid.Column="0" Tag="⭐" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Really enjoyable" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Tag="👍" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="👍" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Mostly enjoyable" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Tag="👎" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="👎" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Mostly sucks" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Tag="❌" Click="OnRate" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Padding="4,10">
        <StackPanel>
          <TextBlock Text="❌" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock Text="Trash" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                     TextAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,10,0,0"
          MinHeight="36" VerticalAlignment="Center">
      <TextBlock Grid.Column="0" x:Name="StatusText" Text="" FontSize="12" Opacity="0.6"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="BackButton" Content="Back" Click="OnBack" FontSize="12"
              MinWidth="44" MinHeight="32" />
      <Button Grid.Column="2" x:Name="SkipButton" Content="Skip" Click="OnSkip" FontSize="12"
              MinWidth="44" MinHeight="32" />
    </Grid>
  </Grid>
</UserControl>
