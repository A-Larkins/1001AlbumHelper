<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.AlbumListView">
  <!--
    Browse. All looks come from MobileTheme (included once at MainView); this file only says what
    goes where. The header block is pinned and the list scrolls under it, so the list picker and
    the search box stay reachable however far down the 1001 you are.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="header">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="title" Text="Browse" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="CountText" Classes="caption" VerticalAlignment="Bottom"
                     Margin="8,0,0,4" />
        </Grid>

        <!-- Which of the three lists is on screen. -->
        <Border Classes="segTrack">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
            <Button Grid.Column="0" x:Name="Tab1001Button" Classes="seg on" Content="1001"
                    Click="OnPick1001" />
            <Button Grid.Column="1" x:Name="TabMustHearButton" Classes="seg" Content="Must Hear"
                    Click="OnPickMustHear" />
            <Button Grid.Column="2" x:Name="TabReplacementsButton" Classes="seg" Content="Replacements"
                    Click="OnPickReplacements" />
          </Grid>
        </Border>

        <TextBox x:Name="SearchBox" Watermark="Search title or artist…" />

        <!-- Sort: tap a column to sort by it; tap the active one again to flip direction. -->
        <Border Classes="sortBar">
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
            <Button Grid.Column="0" x:Name="SortTitleButton" Classes="sort" Tag="Title" Click="OnSortHeader" />
            <Button Grid.Column="1" x:Name="SortArtistButton" Classes="sort" Tag="Artist" Click="OnSortHeader" />
            <Button Grid.Column="2" x:Name="SortYearButton" Classes="sort" Tag="Year" Click="OnSortHeader" />
            <Button Grid.Column="3" x:Name="SortRatingButton" Classes="sort" Tag="Rating" Click="OnSortHeader" />
          </Grid>
        </Border>

        <!-- Collapses when empty — see the note on the same line in ReplacementsView. -->
        <TextBlock x:Name="SyncText" Classes="caption" TextWrapping="Wrap"
                   IsVisible="{Binding #SyncText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      </StackPanel>
    </Border>

    <!-- Row padding comes from the ListBoxItem style, so rows line up with the header above. -->
    <ListBox x:Name="Rows">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:ViewRow">
          <!-- The rating column is a fixed width, not Auto: an unrated album has nothing in it, and
               an Auto column would collapse and shunt that row's title left of its neighbours'. -->
          <Grid ColumnDefinitions="30,22,*,Auto" Margin="0,11">
            <TextBlock Grid.Column="0" Classes="rowIndex" Text="{Binding Number}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Rating}" VerticalAlignment="Center"
                       FontSize="13" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="rowTitle" Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Classes="rowSub" Text="{Binding Artist}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="3" Classes="chip" Content="{Binding PlaylistLabel}"
                    IsEnabled="{Binding CanQueue}" Click="OnAddToPlaylist"
                    VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
