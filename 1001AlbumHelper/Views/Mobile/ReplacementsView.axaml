<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.ReplacementsView">
  <UserControl.Styles>
    <Style Selector="Button.sort">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="Button.sort.on">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="12,8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Potential replacements" FontSize="22" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="AddToggle" Content="＋ Add album" Click="OnToggleAdd"
                FontSize="12" VerticalAlignment="Center" />
      </Grid>
      <TextBox x:Name="SearchBox" Watermark="Search title or artist…" />

      <!-- Sort: tap a column to sort by it; tap the active one again to flip direction. -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
        <Button Grid.Column="0" x:Name="SortTitleButton" Classes="sort" Tag="Title" Click="OnSortHeader"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="1" x:Name="SortArtistButton" Classes="sort" Tag="Artist" Click="OnSortHeader"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="2" x:Name="SortGenreButton" Classes="sort" Tag="Genre" Click="OnSortHeader"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="3" x:Name="SortYearButton" Classes="sort" Tag="Year" Click="OnSortHeader"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>

      <TextBlock x:Name="CountText" Opacity="0.55" FontSize="12" />
      <TextBlock x:Name="SyncText" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />

      <StackPanel x:Name="AddPanel" IsVisible="False" Spacing="6" Margin="0,4,0,2">
        <!-- IsTextCompletionEnabled="False": inline completion rewrites what you're typing
             using whichever result came back first, which fights every keystroke. -->
        <AutoCompleteBox x:Name="TitleBox" Watermark="Album title" FilterMode="None"
                         MinimumPrefixLength="2" IsTextCompletionEnabled="False"
                         MinimumPopulateDelay="0:0:0.35">
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate DataType="local:AlbumSuggestion">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock FontSize="11" Opacity="0.6">
                  <Run Text="{Binding Artist}" /><Run Text=" · " /><Run Text="{Binding Year}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <AutoCompleteBox x:Name="ArtistBox" Watermark="Artist" FilterMode="None"
                         MinimumPrefixLength="2" IsTextCompletionEnabled="False"
                         MinimumPopulateDelay="0:0:0.35" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBox Grid.Column="0" x:Name="YearBox" Watermark="Year" MaxLength="4" Width="90" />
          <Button Grid.Column="1" Content="Add to shortlist" Click="OnAddCandidate"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>
        <TextBlock x:Name="LookupHint" Text="" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
        <TextBlock x:Name="AddStatusText" Text="" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <ListBox x:Name="Rows">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:CandidateAlbum">
          <Grid ColumnDefinitions="*,Auto" Margin="0,4">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Artist}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Genre}" IsVisible="{Binding HasGenre}"
                         Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
              <TextBox Text="{Binding Year, Mode=TwoWay}" Watermark="year" FontSize="11"
                       Padding="4,2" Width="70" HorizontalAlignment="Left"
                       Background="Transparent" BorderThickness="0,0,0,1" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋ P2" Click="OnAddToPlaylist2"
                    VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
