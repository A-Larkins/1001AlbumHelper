<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.ReplacementsView">
  <!--
    Shortlist — the potential replacement albums, each awaiting a Keep or a Nah. Looks come from
    MobileTheme; the only local style is the row's action strip, which has no equivalent elsewhere.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="header">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="Shortlist" />
            <TextBlock x:Name="CountText" Classes="caption" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="AddToggle" Classes="chip gold" Content="＋ Add album"
                  Click="OnToggleAdd" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <TextBox x:Name="SearchBox" Watermark="Search title or artist…" />

        <!-- Sort: tap a column to sort by it; tap the active one again to flip direction. -->
        <Border Classes="sortBar">
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
            <Button Grid.Column="0" x:Name="SortTitleButton" Classes="sort" Tag="Title" Click="OnSortHeader" />
            <Button Grid.Column="1" x:Name="SortArtistButton" Classes="sort" Tag="Artist" Click="OnSortHeader" />
            <Button Grid.Column="2" x:Name="SortGenreButton" Classes="sort" Tag="Genre" Click="OnSortHeader" />
            <Button Grid.Column="3" x:Name="SortYearButton" Classes="sort" Tag="Year" Click="OnSortHeader" />
          </Grid>
        </Border>

        <!-- Collapses when it has nothing to say. On a good sync this line is set to "", and an
             empty TextBlock still reserves its line height — which left a visible gap above the
             list for the case that happens nearly every time. -->
        <TextBlock x:Name="SyncText" Classes="caption" TextWrapping="Wrap"
                   IsVisible="{Binding #SyncText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Undo sits with the message it undoes ("Dropped …"), not up in the header. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" x:Name="StatusText" Classes="caption" TextWrapping="Wrap"
                     IsVisible="False" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="UndoButton" Classes="chip quiet" Content="Undo"
                  Click="OnUndo" IsVisible="False" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="AddPanel" Classes="card" IsVisible="False" Padding="14" Margin="0,2,0,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="rubric" Text="NEW CANDIDATE" />
            <!-- IsTextCompletionEnabled="False": inline completion rewrites what you're typing
                 using whichever result came back first, which fights every keystroke. -->
            <AutoCompleteBox x:Name="TitleBox" Watermark="Album title" FilterMode="None"
                             MinimumPrefixLength="2" IsTextCompletionEnabled="False"
                             MinimumPopulateDelay="0:0:0.35">
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate DataType="local:AlbumSuggestion">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" Opacity="0.6">
                      <Run Text="{Binding Artist}" /><Run Text=" · " /><Run Text="{Binding Year}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <AutoCompleteBox x:Name="ArtistBox" Watermark="Artist" FilterMode="None"
                             MinimumPrefixLength="2" IsTextCompletionEnabled="False"
                             MinimumPopulateDelay="0:0:0.35" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBox Grid.Column="0" x:Name="YearBox" Watermark="Year" MaxLength="4" Width="86" />
              <Button Grid.Column="1" Classes="primary" Content="Add to shortlist" Click="OnAddCandidate"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Grid>
            <TextBlock x:Name="LookupHint" Classes="caption" Text="" TextWrapping="Wrap" />
            <TextBlock x:Name="AddStatusText" Classes="caption" Text="" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>

    <ListBox x:Name="Rows">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:CandidateAlbum">
          <!-- Title over artist, then one line carrying everything else: the editable year, the
               genre, and the three verdicts pushed right. They can't share a line with the title
               (which wraps), but on a line of their own they fit with room to spare — and keeping
               them on one line stops the buttons drifting closer to the next album than to theirs. -->
          <StackPanel Margin="0,13" Spacing="2">
            <TextBlock Classes="rowTitle" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="rowSub" Text="{Binding Artist}" TextWrapping="Wrap" />

            <!-- Why a Keep didn't go through ("Discogs didn't find a year", "already on the 1001"). -->
            <TextBlock Classes="caption warn" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,7,0,0">
              <TextBox Grid.Column="0" Classes="inline" Text="{Binding Year, Mode=TwoWay}"
                       Watermark="year" Width="44" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Genre}"
                         IsVisible="{Binding HasGenre}" VerticalAlignment="Center"
                         Margin="2,0,6,0" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="chip quiet" Content="＋ P2" Click="OnAddToPlaylist2" />
              <Button Grid.Column="3" Classes="chip gold" Content="Keep" Click="OnKeepRow" />
              <Button Grid.Column="4" Classes="chip quiet" Content="Nah" Click="OnDropRow" />
            </Grid>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
