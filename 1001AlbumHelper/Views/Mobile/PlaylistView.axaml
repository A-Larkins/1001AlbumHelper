<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_1001AlbumHelper"
             x:Class="_1001AlbumHelper.PlaylistView">
  <!--
    One working playlist. Used twice — Playlist 1 (from the 1001) and Playlist 2 (recommendations)
    — so the heading, subtitle and Apple Music name all arrive via Configure.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="header">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Classes="title" />
            <TextBlock x:Name="SubtitleText" Classes="caption" />
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="CountText" Classes="caption" VerticalAlignment="Bottom"
                     Margin="8,0,0,3" />
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button x:Name="ImportButton" Grid.Column="0" Classes="ghost" Content="⬇  Pull down"
                  Click="OnImportFromAppleMusic" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  ToolTip.Tip="Replace this list with what Apple Music has" />
          <Button x:Name="PushButton" Grid.Column="1" Classes="accent" Content="⬆  Push all"
                  Click="OnPushToAppleMusic" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  ToolTip.Tip="Push all to Apple Music" />
        </Grid>

        <TextBlock x:Name="StatusText" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
        <ItemsControl x:Name="FailuresList" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="caption error" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Border>

    <!-- Apple Music has no remove API, so cleanup is a checklist you work through by hand. -->
    <Border x:Name="ToRemoveSection" DockPanel.Dock="Bottom" Classes="card" IsVisible="False"
            Padding="14" Margin="16,8,16,14">
      <StackPanel Spacing="6">
        <TextBlock x:Name="ToRemoveHeader" Classes="rubric" />
        <TextBlock Classes="caption"
                   Text="Apple Music can't remove these for you — delete them there yourself, then check them off."
                   TextWrapping="Wrap" />
        <ItemsControl x:Name="ToRemoveRows" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:PlaylistEntry">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <TextBlock Grid.Column="0" Classes="rowSub" Text="{Binding Display}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="chip quiet" Content="✓ Deleted"
                        Click="OnConfirmRemoved" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Panel>
      <ListBox x:Name="Rows">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:PlaylistEntry">
            <!-- Title over artist, matching the browse list, rather than one run-together line. -->
            <!-- Two verdicts and a remove. Playlist 2 only: it's the recommendations queue, so the
                 album playing right now is exactly the kind the shortlist and the replacements list
                 are for — and reaching them from here beats going back to Browse to search for what
                 you're already listening to. "＋" writes it down undecided; "Keep" is the decision,
                 and puts it on the replacements list proper as well. -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,11">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="rowSub" Text="{Binding Artist}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="chip quiet" Content="＋ Shortlist"
                      IsVisible="{Binding $parent[local:PlaylistView].IsRecommendations}"
                      Click="OnAddToShortlist" VerticalAlignment="Center" Margin="8,0,0,0"
                      ToolTip.Tip="Write it down as a candidate — decide later." />
              <Button Grid.Column="2" Classes="chip gold" Content="Keep"
                      IsVisible="{Binding $parent[local:PlaylistView].IsRecommendations}"
                      Click="OnKeep" VerticalAlignment="Center" Margin="6,0,0,0"
                      ToolTip.Tip="Put it on the replacements list now, and mark it kept on the shortlist." />
              <Button Grid.Column="3" Classes="chip quiet" Content="✕" Click="OnRemove"
                      VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Classes="caption"
                 Text="Nothing here yet — add albums from the List or Shortlist tab."
                 TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                 IsHitTestVisible="False" IsVisible="False" />
    </Panel>
  </DockPanel>
</UserControl>
