<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="_1001AlbumHelper.RatePage">


  <UserControl.Styles>
    <!-- Segmented mode switch -->
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="#1d1714" />
      <Setter Property="BorderBrush" Value="#362b23" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Foreground" Value="#9c8b7c" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#4a3a2c" />
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Background" Value="#3a2b12" />
      <Setter Property="BorderBrush" Value="#b3852f" />
      <Setter Property="Foreground" Value="#f5c985" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Rating buttons -->
    <Style Selector="Button.rate">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,12" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#241d18" />
      <Setter Property="BorderBrush" Value="#3a2e25" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rate:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#332821" />
      <Setter Property="BorderBrush" Value="#d8a24a" />
    </Style>
    <Style Selector="Button.rate:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.rate TextBlock.sym">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rate TextBlock.lbl">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#c0ad97" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.rate TextBlock.key">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6d5f53" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#241d18" />
      <Setter Property="BorderBrush" Value="#362b23" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Foreground" Value="#d8ccc0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#4a3a2c" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="22,18,22,16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- Mode switch + counter -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Button x:Name="NextUpButton" Classes="seg on" Content="🎧  Next up" Click="OnPickNextUp"
                ToolTip.Tip="Albums with no mark yet — in list order." />
        <Button x:Name="BackfillButton" Classes="seg" Content="📼  Backfill ✓" Click="OnPickBackfill"
                ToolTip.Tip="Albums you marked listened (✓) but never rated." />
        <Button x:Name="RevisitButton" Classes="seg" Content="🔁  Revisit" Click="OnPickRevisit"
                ToolTip.Tip="Albums you've already rated — for changing your mind." />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <CheckBox x:Name="ShuffleBox" Content="Shuffle" FontSize="12" Foreground="#b3a394"
                  IsCheckedChanged="OnShuffleChanged" />
        <TextBlock x:Name="RemainingText" Text="" FontSize="12" Foreground="#9c8b7c"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Which ratings Revisit walks through. Hidden for the other two queues, whose albums have
         no rating to filter by. -->
    <StackPanel Grid.Row="1" x:Name="FilterPanel" Orientation="Horizontal" Spacing="6"
                Margin="0,0,0,14" IsVisible="False">
      <TextBlock Text="Revisit:" FontSize="12" Foreground="#8a7a6c" VerticalAlignment="Center"
                 Margin="0,0,4,0" />
      <Button Classes="seg on" Tag="" Content="All" Click="OnPickFilter" />
      <Button Classes="seg" Tag="⭐" Content="⭐" Click="OnPickFilter" />
      <Button Classes="seg" Tag="👍" Content="👍" Click="OnPickFilter" />
      <Button Classes="seg" Tag="👎" Content="👎" Click="OnPickFilter" />
      <Button Classes="seg" Tag="❌" Content="❌" Click="OnPickFilter" />
    </StackPanel>

    <Border Grid.Row="2" Height="1" Margin="0,0,0,16" Background="#3a2e25" />

    <!-- The album -->
    <Border Grid.Row="3" x:Name="AlbumCard" CornerRadius="16" Background="#141010" BorderBrush="#2a211b" BorderThickness="1"
            ClipToBounds="True">
      <Panel>
        <!-- The cover again, blurred and dimmed right down, as the card's backdrop — the album's own
             colors behind it rather than a flat panel. Hidden until there's art. -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.32" IsVisible="False" IsHitTestVisible="False">
          <Image.Effect><BlurEffect Radius="70" /></Image.Effect>
        </Image>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Color="#55141010" Offset="0" />
              <GradientStop Color="#CC141010" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

      <Panel Margin="16">
        <!-- Album card: the cover, then the words under it, centered. The cover's size is set in
             code to fill the card (see SizeArt). -->
        <StackPanel x:Name="AlbumPanel" HorizontalAlignment="Center" VerticalAlignment="Center">

          <!-- Cover art. The sleeve placeholder shows while the lookup runs and stays put when an
               album has no art, so the card never jumps between two heights. -->
          <Border x:Name="ArtFrame" Width="170" Height="170"
                  CornerRadius="18" ClipToBounds="True"
                  Background="#1b1512" BorderBrush="#40332a" BorderThickness="1"
                  BoxShadow="0 20 60 0 #C0000000"
                  HorizontalAlignment="Center">
            <Panel>
              <TextBlock x:Name="ArtPlaceholder" Text="♫" FontSize="80" Foreground="#40342a"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="ArtImage" Stretch="UniformToFill" IsVisible="False" />
            </Panel>
          </Border>

          <StackPanel x:Name="InfoPanel" Margin="0,18,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="" FontSize="40" FontWeight="Bold" Foreground="#f3e9df"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock x:Name="ArtistText" Text="" FontSize="24" Foreground="#e0b479"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="YearText" Text="" FontSize="18" Foreground="#9c8b7c"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="PositionText" Text="" FontSize="13" Foreground="#8a7a6c"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <!-- Only shown for an album that already has a rating — otherwise there's nothing to say. -->
            <TextBlock x:Name="CurrentRatingText" Text="" FontSize="14" Foreground="#e0b479"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                       Margin="0,8,0,0" IsVisible="False" />
          </StackPanel>
        </StackPanel>

        <!-- Shown while loading, and when a queue runs out -->
        <TextBlock x:Name="MessageText" Text="Loading…" FontSize="15" Foreground="#b3a394"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
      </Panel>
      </Panel>
    </Border>

    <!-- Ratings -->
    <Grid Grid.Row="4" x:Name="RatingRow" ColumnDefinitions="*,*,*,*" Margin="0,16,0,0">
      <Button Grid.Column="0" Classes="rate" Tag="⭐" Click="OnRate" Margin="0,0,5,0">
        <StackPanel>
          <TextBlock Classes="sym" Text="⭐" />
          <TextBlock Classes="lbl" Text="Really enjoyable" />
          <TextBlock Classes="key" Text="1" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="rate" Tag="👍" Click="OnRate" Margin="5,0,5,0">
        <StackPanel>
          <TextBlock Classes="sym" Text="👍" />
          <TextBlock Classes="lbl" Text="Mostly enjoyable" />
          <TextBlock Classes="key" Text="2" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="rate" Tag="👎" Click="OnRate" Margin="5,0,5,0">
        <StackPanel>
          <TextBlock Classes="sym" Text="👎" />
          <TextBlock Classes="lbl" Text="Mostly sucks" />
          <TextBlock Classes="key" Text="3" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="rate" Tag="❌" Click="OnRate" Margin="5,0,0,0">
        <StackPanel>
          <TextBlock Classes="sym" Text="❌" />
          <TextBlock Classes="lbl" Text="Trash" />
          <TextBlock Classes="key" Text="4" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="12" Foreground="#8a7a6c"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="BackButton" Classes="ghost" Content="Back  (B)" Click="OnBack" />
        <Button x:Name="SkipButton" Classes="ghost" Content="Skip  (S)" Click="OnSkip" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
