<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="_1001AlbumHelper.PlaylistsPage"
        xmlns:local="clr-namespace:_1001AlbumHelper">


  <UserControl.Styles>
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="#1d1714" />
      <Setter Property="BorderBrush" Value="#362b23" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Foreground" Value="#9c8b7c" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#4a3a2c" />
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Background" Value="#3a2b12" />
      <Setter Property="BorderBrush" Value="#b3852f" />
      <Setter Property="Foreground" Value="#f5c985" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#221b16" />
      <Setter Property="BorderBrush" Value="#3a2e25" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Foreground" Value="#cbbdb0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#54453a" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="20,18,20,16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- Which playlist -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
      <Button Grid.Column="0" x:Name="Playlist1Button" Classes="seg on"
              Content="💿  Playlist 1 · from the 1001" Click="OnPickPlaylist1" Margin="0,0,8,0" />
      <Button Grid.Column="1" x:Name="Playlist2Button" Classes="seg"
              Content="✨  Playlist 2 · recommended" Click="OnPickPlaylist2" />
      <Button Grid.Column="3" x:Name="ImportButton" Classes="ghost" Content="Get from Apple Music"
              Click="OnImportFromAppleMusic" Margin="0,0,8,0" VerticalAlignment="Center"
              ToolTip.Tip="Make this list match your Apple Music playlist exactly. Anything here that isn't in that playlist is dropped." />
      <Button Grid.Column="4" x:Name="PushButton" Classes="ghost" Content="Send new to Apple Music"
              Click="OnPushToAppleMusic" VerticalAlignment="Center"
              ToolTip.Tip="Add the albums marked “not sent yet” to your Apple Music playlist — the whole album, original release, never a deluxe edition." />
    </Grid>

    <!-- Status -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="2,0,2,10">
      <TextBlock Grid.Column="0" x:Name="StatusText" Text="" FontSize="12" Foreground="#a99884"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" x:Name="CountText" Text="" FontSize="12" Foreground="#9c8b7c"
                 VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>

    <!-- Column headings -->
    <Grid Grid.Row="2" ColumnDefinitions="*,240,58,112,74,90,124" Margin="12,0,16,6">
      <TextBlock Grid.Column="0" Text="ALBUM" FontSize="10.5" FontWeight="Bold" Foreground="#6f6053" />
      <TextBlock Grid.Column="1" Text="ARTIST" FontSize="10.5" FontWeight="Bold" Foreground="#6f6053" />
      <TextBlock Grid.Column="2" Text="YEAR" FontSize="10.5" FontWeight="Bold" Foreground="#6f6053" />
    </Grid>

    <Border Grid.Row="3" CornerRadius="12" Background="#120f0e" BorderBrush="#282019" BorderThickness="1">
      <Panel>
        <ListBox x:Name="RowsList" Background="Transparent" BorderThickness="0" Padding="4">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:PlaylistEntry">
              <Grid ColumnDefinitions="*,240,58,112,74,90,124" Margin="8,6">
                <!-- A DockPanel, not a horizontal StackPanel: a StackPanel gives the title unlimited
                     width, so it never trims and runs on under the artist column. -->
                <DockPanel Grid.Column="0" Margin="0,0,14,0">
                  <!-- A short track count usually means it was half-deleted by hand in Music. -->
                  <TextBlock DockPanel.Dock="Right" Text="{Binding PartialWarning}" FontSize="11"
                             Foreground="#d08a4a" Margin="7,0,0,0"
                             VerticalAlignment="Center" IsVisible="{Binding IsPartial}" />
                  <!-- What "Send new to Apple Music" will send. -->
                  <TextBlock DockPanel.Dock="Right" Text="not sent yet" FontSize="11"
                             Foreground="#c9a35a" Margin="7,0,0,0"
                             VerticalAlignment="Center" IsVisible="{Binding !InAppleMusic}" />
                  <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#f0e5da"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Title}" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="12.5"
                           Foreground="#b9a894" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Year}" FontSize="12"
                           Foreground="#7f7164" FontFamily="Menlo,Consolas,monospace" VerticalAlignment="Center" />
                <!-- Playlist 2 only: it's the recommendations queue, so what's in it is exactly
                     what the two replacement lists are for. "＋ Shortlist" writes the album down
                     undecided; "Keep" is the decision, and reaches the replacements list itself. -->
                <Button Grid.Column="3" Classes="ghost" Content="＋  Shortlist" Click="OnAddToShortlist"
                        IsVisible="{Binding $parent[local:PlaylistsPage].IsRecommendations}"
                        HorizontalAlignment="Right" Padding="8,4" FontSize="11"
                        ToolTip.Tip="Put this album on the potentials shortlist." />
                <Button Grid.Column="4" Classes="ghost" Content="Keep" Click="OnKeep"
                        IsVisible="{Binding $parent[local:PlaylistsPage].IsRecommendations}"
                        HorizontalAlignment="Right" Padding="8,4" FontSize="11"
                        ToolTip.Tip="Put this on the replacements list now, and mark it kept on the shortlist." />
                <!-- Two removals on Playlist 2: sometimes it's just leaving the queue, sometimes
                     it's a verdict on the album as a replacement too. -->
                <Button Grid.Column="5" Classes="ghost" Content="✕  Remove" Click="OnRemove"
                        HorizontalAlignment="Right" Padding="8,4" FontSize="11"
                        ToolTip.Tip="Take this off the list and out of the Apple Music playlist (your library keeps it). The shortlist is left alone." />
                <Button Grid.Column="6" Classes="ghost" Content="✕  Remove + drop" Click="OnRemoveAndDrop"
                        IsVisible="{Binding $parent[local:PlaylistsPage].IsRecommendations}"
                        HorizontalAlignment="Right" Padding="8,4" FontSize="11"
                        ToolTip.Tip="Take this out of the playlist, and drop it from the shortlist too, so it isn't offered again. An album you've kept stays kept." />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" FontSize="14" Foreground="#a99884"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="40" IsHitTestVisible="False" IsVisible="False"
                   Text="Nothing queued here yet — add albums from Browse or Potential replacements, or bring in what the Music app playlist already has with “Get from Apple Music”." />
      </Panel>
    </Border>

    <!-- Albums Apple Music still has but the working list doesn't -->
    <Border Grid.Row="4" x:Name="ToRemoveSection" IsVisible="False" Margin="0,12,0,0"
            CornerRadius="12" Background="#17110d" BorderBrush="#3a2a1a" BorderThickness="1"
            Padding="14,11" MaxHeight="190">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="ToRemoveHeader" FontSize="12" FontWeight="SemiBold"
                   Foreground="#e2a75f" />
        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="#8b7969" TextWrapping="Wrap"
                   Margin="0,3,0,7"
                   Text="You took these off the list, but your Apple Music playlist still has them. “Remove from Apple Music” takes each one out of the playlist (your library keeps it); if you've already deleted it by hand, it just clears the row." />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ToRemoveRows">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:PlaylistEntry">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="12"
                             Foreground="#a99884" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="ghost" Content="Remove from Apple Music" Click="OnConfirmRemoved"
                          Margin="10,0,0,0" Padding="8,4" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <ItemsControl Grid.Column="0" x:Name="FailuresList" IsVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:PushFailure">
            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
              <TextBlock Grid.Column="0" Text="{Binding Text}" FontSize="11" Foreground="#c96a5a"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <!-- Not in the library: AppleScript can't add a catalog album, but one click in Music can. -->
              <Button Grid.Column="1" Classes="ghost" Content="Open in Music" Click="OnOpenInMusic"
                      IsVisible="{Binding CanOpen}" Margin="10,0,12,0" Padding="8,3" FontSize="11"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Show this album in the Music app, so you can add it to your library with ＋." />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="ghost" Content="Reload" Click="OnReload" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
