<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="_1001AlbumHelper.MainWindow"
        Width="1260" Height="800" MinWidth="1080" MinHeight="640"
        Title="1001 Albums Helper"
        RequestedThemeVariant="Dark">

  <Window.Background>
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="30%,100%">
      <GradientStop Color="#151020" Offset="0" />
      <GradientStop Color="#0e0b09" Offset="0.45" />
      <GradientStop Color="#0b0807" Offset="1" />
    </LinearGradientBrush>
  </Window.Background>

  <Window.Styles>
    <!-- ===== Sidebar ===== -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Foreground" Value="#b9a894" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#211a15" />
    </Style>
    <Style Selector="Button.nav.on">
      <Setter Property="Background" Value="#3a2b12" />
      <Setter Property="Foreground" Value="#f5c985" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.on:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#43321a" />
    </Style>
    <Style Selector="Button.nav TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6f6053" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ===== Action cards ===== -->
    <Style Selector="Button.card">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="19,19" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#241d17" Offset="0" />
          <GradientStop Color="#1b1511" Offset="1" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="BorderBrush" Value="#332921" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2b2219" />
      <Setter Property="BorderBrush" Value="#544133" />
    </Style>
    <Style Selector="Button.card:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- The primary action -->
    <Style Selector="Button.card.hero">
      <Setter Property="Padding" Value="23,24" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#4e3714" Offset="0" />
          <GradientStop Color="#2b2010" Offset="1" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="BorderBrush" Value="#a97c2c" />
    </Style>
    <Style Selector="Button.card.hero:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#573d16" />
      <Setter Property="BorderBrush" Value="#e0aa54" />
    </Style>

    <!-- Icon badge -->
    <Style Selector="Border.badge">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#2e251d" />
      <Setter Property="BorderBrush" Value="#41332812" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.card.hero Border.badge">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#6b4a17" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.card.hero Border.badge TextBlock">
      <Setter Property="FontSize" Value="22" />
    </Style>

    <!-- Card text -->
    <Style Selector="Button.card TextBlock.title">
      <Setter Property="Foreground" Value="#f0e5da" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.card TextBlock.desc">
      <Setter Property="Foreground" Value="#a99884" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style Selector="Button.card.hero TextBlock.title">
      <Setter Property="Foreground" Value="#f7cf90" />
      <Setter Property="FontSize" Value="16.5" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.card.hero TextBlock.desc">
      <Setter Property="Foreground" Value="#c9b499" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Small ghost buttons ===== -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#221b16" />
      <Setter Property="BorderBrush" Value="#3a2e25" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="Foreground" Value="#cbbdb0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#54453a" />
      <Setter Property="Foreground" Value="#f0e5da" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="#6f6053" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="210,*">

    <!-- ===== Sidebar: the same sections as the phone's tab bar, plus More ===== -->
    <Border Grid.Column="0" Background="#0c0a09" BorderBrush="#221b16" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,22">
          <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center"
                  Background="#111014" BorderBrush="#2a2733" BorderThickness="1">
            <Border Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Background>
                <RadialGradientBrush>
                  <GradientStop Color="#f2c078" Offset="0" />
                  <GradientStop Color="#a86f24" Offset="1" />
                </RadialGradientBrush>
              </Border.Background>
              <Border Width="3" Height="3" CornerRadius="2" Background="#111014"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="1001 Albums" FontSize="15" FontWeight="Bold" Foreground="#f3e9df" />
            <TextBlock Text="Helper" FontSize="11.5" Foreground="#8b7969" />
          </StackPanel>
        </StackPanel>

        <!-- Running status, pinned to the bottom of the sidebar. -->
        <Border DockPanel.Dock="Bottom" CornerRadius="999" HorizontalAlignment="Left" Margin="4,0,0,0"
                Background="#1c1613" BorderBrush="#3a2e25" BorderThickness="1" Padding="11,6">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#7c6d60" />
            <TextBlock x:Name="StatusText" Text="Idle" FontSize="11.5" Foreground="#a99884" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="3">
          <Button x:Name="NavRate" Classes="nav on" Click="OnNav" Tag="Rate"
                  ToolTip.Tip="Rate the next album, backfill ✓ marks, or change a rating.  ⌘1">
            <Grid ColumnDefinitions="28,*,Auto"><TextBlock Text="🎧" /><TextBlock Grid.Column="1" Text="Rate" /><TextBlock Grid.Column="2" Classes="hint" Text="⌘1" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button x:Name="NavBrowse" Classes="nav" Click="OnNav" Tag="Browse"
                  ToolTip.Tip="Search the 1001, Must Hear and Replacements lists.  ⌘2">
            <Grid ColumnDefinitions="28,*,Auto"><TextBlock Text="🔍" /><TextBlock Grid.Column="1" Text="Browse" /><TextBlock Grid.Column="2" Classes="hint" Text="⌘2" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button x:Name="NavShortlist" Classes="nav" Click="OnNav" Tag="Shortlist"
                  ToolTip.Tip="Potential replacements — keep them or drop them.  ⌘3">
            <Grid ColumnDefinitions="28,*,Auto"><TextBlock Text="🗂" /><TextBlock Grid.Column="1" Text="Shortlist" /><TextBlock Grid.Column="2" Classes="hint" Text="⌘3" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button x:Name="NavPlaylists" Classes="nav" Click="OnNav" Tag="Playlists"
                  ToolTip.Tip="Playlist 1 and 2 — send them to the Music app.  ⌘4">
            <Grid ColumnDefinitions="28,*,Auto"><TextBlock Text="🎵" /><TextBlock Grid.Column="1" Text="Playlists" /><TextBlock Grid.Column="2" Classes="hint" Text="⌘4" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button x:Name="NavMore" Classes="nav" Click="OnNav" Tag="More"
                  ToolTip.Tip="Add an album, favourites, analytics, export, sync, and the activity log.  ⌘5">
            <Grid ColumnDefinitions="28,*,Auto">
              <TextBlock Text="⋯" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <TextBlock Text="More" VerticalAlignment="Center" />
                <!-- Lit when the lists have drifted from the 1001 and a sync would fix it. -->
                <Ellipse x:Name="MoreDot" Width="7" Height="7" Fill="#e6a54b" IsVisible="False" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="hint" Text="⌘5" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Pages: built on first visit, then kept (see MainWindow.Navigate) ===== -->
    <Panel Grid.Column="1" x:Name="PageHost">

  <Grid x:Name="MorePage" IsVisible="False" Margin="24,20,24,18" RowDefinitions="Auto,*,Auto,Auto">

    <!-- ===== Header ===== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="More" FontSize="21" FontWeight="Bold" Foreground="#f3e9df" />
        <TextBlock Text="Everything that isn't rating, browsing, the shortlist or the playlists."
                   FontSize="12.5" Foreground="#a99884" />
      </StackPanel>
      <Button Grid.Column="1" x:Name="CheckButton" Classes="ghost" Content="Check connection"
              Tag="sync-check" Click="OnRun" VerticalAlignment="Center"
              ToolTip.Tip="Sign in and list the sheet’s tabs — a safe, read-only check." />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
    <StackPanel Spacing="20">
      <StackPanel Spacing="10">
        <TextBlock Classes="sectionLabel" Text="LISTS" />
            <Button x:Name="AddAlbumButton" Classes="card" Click="OnAddAlbum">
              <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="badge">
                  <TextBlock Text="➕" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="Add an album" />
                  <TextBlock Classes="desc" Text="Put an album straight onto the replacements list — it slots in by year. (To decide later instead, use Shortlist.)" />
                </StackPanel>
              </Grid>
            </Button>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="sectionLabel" Text="APPLE MUSIC" />
        <!-- Two presses, deliberately: the first only looks, the second writes to the real library.
             The card's own text is the confirmation step — see OnRun's "favorites-*" cases. -->
        <Button x:Name="FavoritesButton" Classes="card" Tag="favorites-check" Click="OnRun">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Classes="badge">
              <TextBlock Text="♥" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FavoritesTitleText" Classes="title" Text="Backfill favourites" />
              <TextBlock x:Name="FavoritesDescText" Classes="desc"
                         Text="Put a heart on every album of the finished list that Apple Music hasn't already got one on, and mirror the same albums into “Almost forgot to listen to these today”. Press once to see what it would do — nothing is written until you press again." />
            </StackPanel>
            <Border Grid.Column="2" x:Name="FavoritesBadge" IsVisible="False" VerticalAlignment="Center"
                    Background="#3a2b12" BorderBrush="#b3852f" BorderThickness="1" CornerRadius="6"
                    Padding="7,3" Margin="10,0,0,0">
              <TextBlock x:Name="FavoritesBadgeText" Text="" FontSize="10" FontWeight="Bold"
                         Foreground="#f5c985" />
            </Border>
          </Grid>
        </Button>
      </StackPanel>

      <StackPanel Spacing="10" x:Name="InsightsSection" IsVisible="False">
        <TextBlock Classes="sectionLabel" Text="INSIGHTS" />
        <Button x:Name="AnalyticsButton" Classes="card" Click="OnAnalytics">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Classes="badge">
              <TextBlock Text="📊" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="Analytics" />
              <TextBlock Classes="desc" Text="Taste patterns across your ratings — by decade and genre." />
            </StackPanel>
          </Grid>
        </Button>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="sectionLabel" Text="SHEETS &amp; EXPORT" />
        <Grid ColumnDefinitions="*,*">
        <Button Grid.Column="0" x:Name="ExportButton" Classes="card" Tag="export-pdf" Click="OnRun"
                Margin="0,0,6,0">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Classes="badge">
              <TextBlock Text="📄" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="Export as PDF" />
              <TextBlock Classes="desc" Text="Both lists, numbered straight through, in two sections." />
            </StackPanel>
          </Grid>
        </Button>

        <Button Grid.Column="1" x:Name="SyncButton" Classes="card" Tag="sync-all" Click="OnRun"
                Margin="6,0,0,0">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Classes="badge">
              <TextBlock Text="🔄" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
              <!-- The badge sits beside the title so a half-width card doesn't squeeze it. -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="title" Text="Sync all" VerticalAlignment="Center" />
                <Border x:Name="SyncBadge" IsVisible="False" VerticalAlignment="Center"
                        CornerRadius="999" Background="#5a3a12" BorderBrush="#d8a24a"
                        BorderThickness="1" Padding="8,2">
                  <TextBlock x:Name="SyncBadgeText" Text="" FontSize="10" FontWeight="Bold"
                             Foreground="#f7cf90" />
                </Border>
              </StackPanel>
              <TextBlock x:Name="SyncDescText" Classes="desc"
                         Text="Reconciles both lists with the 1001 list." />
            </StackPanel>
          </Grid>
        </Button>
        </Grid>
      </StackPanel>

    </StackPanel>
    </ScrollViewer>

    <!-- ===== Log ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,7">
      <TextBlock Grid.Column="0" Classes="sectionLabel" Text="ACTIVITY LOG" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <TextBlock x:Name="ElapsedText" Text="" FontSize="11.5" Foreground="#6f6053" VerticalAlignment="Center" />
        <Button Classes="ghost" Content="Clear" Click="OnClearLog" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Height="110" CornerRadius="12" Background="#120f0e"
            BorderBrush="#282019" BorderThickness="1">
      <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               BorderThickness="0" Background="Transparent" Foreground="#bcae9f"
               FontFamily="Menlo,Consolas,monospace" FontSize="11.5" Padding="13,11"
               VerticalContentAlignment="Top"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               Text="Ready. Output from anything the app does streams here live." />
    </Border>
  </Grid>

    </Panel>
  </Grid>
</Window>
