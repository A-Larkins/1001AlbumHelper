<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="_1001AlbumHelper.InsightsPage">

  <!-- The tiles, cards and charts are built in code (InsightsPage.axaml.cs): their geometry is the data. -->
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#17120f" />
      <Setter Property="BorderBrush" Value="#2c231c" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,16,18,16" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#f3e9df" />
    </Style>
    <Style Selector="TextBlock.sectionHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#a99884" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#f0e5da" />
    </Style>
    <Style Selector="TextBlock.cardHint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8b7969" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.tileLabel">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#8b7969" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.tileValue">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#f7cf90" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.tileUnit">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#8b7969" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="5,0,0,4" />
    </Style>
    <Style Selector="TextBlock.tileDetail">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#a99884" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#e6d9cc" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rowValue">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#f0e5da" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rowMuted">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#8b7969" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.axis">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8b7969" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,30" Spacing="16">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="Insights" FontSize="21" FontWeight="Bold" Foreground="#f3e9df" />
          <TextBlock x:Name="SummaryText" Text="Loading…" FontSize="12.5" Foreground="#a99884" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="ReloadButton" Classes="ghost" Content="Reload" Click="OnReload" />
          <Button x:Name="ExportPdfButton" Classes="ghost" Content="Export as PDF" Click="OnExportPdf"
                  ToolTip.Tip="These insights on their own. The Export page's PDF carries them too, after the list." />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="StatusText" Text="" FontSize="11.5" Foreground="#a99884" IsVisible="False"
                 TextTrimming="CharacterEllipsis" Margin="0,-6,0,0" />

      <!-- ===== The 1001 ===== -->
      <StackPanel x:Name="The1001Section" Spacing="16" IsVisible="False">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="The 1001" />
          <TextBlock x:Name="The1001Hint" Classes="sectionHint" Text="" />
        </StackPanel>
        <ContentControl x:Name="The1001Tiles" />
        <ContentControl x:Name="RatingMixHost" />
        <Grid ColumnDefinitions="*,16,*">
          <ContentControl Grid.Column="0" x:Name="DecadeHost" />
          <ContentControl Grid.Column="2" x:Name="MostHeardHost" />
        </Grid>
        <Grid ColumnDefinitions="*,16,*">
          <ContentControl Grid.Column="0" x:Name="FavoritesHost" />
          <ContentControl Grid.Column="2" x:Name="LeastHost" />
        </Grid>
      </StackPanel>

      <!-- ===== The albums you added ===== -->
      <StackPanel x:Name="AdditionsSection" Spacing="16" IsVisible="False">
        <Border Height="1" Background="#2c231c" Margin="0,14,0,6" />
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="Albums you added" />
          <TextBlock Classes="sectionHint"
                     Text="The replacements you put on the finished list in place of the ones you cut — measured against the 1001, not mixed into it." />
        </StackPanel>
        <ContentControl x:Name="AdditionsTiles" />
        <Grid ColumnDefinitions="*,16,*">
          <ContentControl Grid.Column="0" x:Name="AdditionsDecadeHost" />
          <ContentControl Grid.Column="2" x:Name="AdditionsArtistHost" />
        </Grid>
      </StackPanel>

      <!-- ===== The shortlist ===== -->
      <StackPanel x:Name="ShortlistSection" Spacing="16" IsVisible="False">
        <Border Height="1" Background="#2c231c" Margin="0,14,0,6" />
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="Your shortlist" />
          <TextBlock x:Name="ShortlistHint" Classes="sectionHint" Text="" />
        </StackPanel>
        <Grid ColumnDefinitions="*,16,*">
          <ContentControl Grid.Column="0" x:Name="ShortlistDecadeHost" />
          <ContentControl Grid.Column="2" x:Name="ShortlistGenreHost" />
        </Grid>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
